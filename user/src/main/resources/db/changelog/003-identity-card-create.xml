<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <changeSet id="002-identity-card-create" author="kbanach">
        <createTable tableName="identity_card">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="identity_card_number" type="varchar(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="issue_place" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="issuing_authority" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="valid_util" type="date">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>